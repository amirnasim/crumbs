# =============================================================================
# CRUMBS — Production Environment (.env on server)
# Copy from .env.example and set all secrets before launch.
# Launch guide: docs/LAUNCH_CHECKLIST.md
# =============================================================================

# Django core
SECRET_KEY=generate-a-50-plus-char-random-secret-key
DEBUG=False
LOCAL_PROD_DRY_RUN=False
ALLOWED_HOSTS=crumbs.ir,www.crumbs.ir,localhost,127.0.0.1
# Phase 1 (HTTP): http://crumbs.ir,http://www.crumbs.ir
# Phase 2 (HTTPS): https://crumbs.ir,https://www.crumbs.ir
CSRF_TRUSTED_ORIGINS=https://crumbs.ir,https://www.crumbs.ir

# Domain (required for VPS deploy)
DOMAIN=crumbs.ir
CERTBOT_EMAIL=admin@crumbs.ir
ENABLE_HTTPS=False

# Site & SEO
# Phase 1: SITE_URL=http://crumbs.ir  |  Phase 2: SITE_URL=https://crumbs.ir
SITE_URL=https://crumbs.ir
SITE_NAME=کرامبز
SEO_DEFAULT_DESCRIPTION=کرامبز — کوکی و قهوه لوکس دست‌ساز. سفارش آنلاین با ارسال در تهران و سراسر ایران.

# PostgreSQL
POSTGRES_DB=crumbs
POSTGRES_USER=crumbs
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# Redis (DB 1 = Django cache/sessions; DB 0 = Celery broker via CELERY_BROKER_URL)
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_TIMEOUT_CATALOG=300

# Logging & monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Optional fallback used by health/Sentry when SENTRY_RELEASE is empty
APP_VERSION=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email (optional)
DEFAULT_FROM_EMAIL=noreply@crumbs.local
SERVER_EMAIL=noreply@crumbs.local
NOTIFICATIONS_EMAIL_PROVIDER=django
CAREERS_STAFF_EMAIL=

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Docker / Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_PRELOAD=true
USE_WHITENOISE=False

# Container startup (production default: run migrate/collectstatic explicitly at deploy time)
RUN_MIGRATIONS_ON_STARTUP=false
RUN_COLLECTSTATIC_ON_STARTUP=false

# Production security (Phase 1: ENABLE_HTTPS=False — prod settings force insecure cookies until SSL)
# Phase 2: ENABLE_HTTPS=True — secure cookies and HSTS applied automatically
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True

# Payments (Iran-first: Zarinpal primary, Stripe optional/sandbox)
DEFAULT_PAYMENT_METHOD=online
DEFAULT_PAYMENT_PROVIDER=zarinpal
ONLINE_PAYMENT_CURRENCY=irr

# Zarinpal (primary online provider)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=False
ZARINPAL_CALLBACK_URL=https://crumbs.ir/payments/zarinpal/callback/

# Stripe (optional — keep disabled in Iran production)
STRIPE_ENABLED=False
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=irr
PAYMENT_SUCCESS_URL=https://crumbs.ir/accounts/orders/
PAYMENT_CANCEL_URL=https://crumbs.ir/cart/

# SMS (Kavenegar)
SMS_PROVIDER=kavenegar
SMS_ENABLED=True
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Fulfillment & SMS quiet hours
SMS_QUIET_HOURS_START=22:00
SMS_QUIET_HOURS_END=08:00
SMS_RATE_LIMIT_PER_USER_PER_DAY=3
SMS_DEDUPE_WINDOW_SECONDS=300
CART_RESERVATION_MINUTES=30

# Loyalty
LOYALTY_POINTS_PER_1000_TOMAN=10
LOYALTY_SILVER_THRESHOLD=1000
LOYALTY_GOLD_THRESHOLD=5000

# Abandoned cart automation
ABANDONED_CART_HOURS=2
ABANDONED_CART_STEP2_HOURS=24
ABANDONED_CART_MAX_REMINDERS=3
ABANDONED_CART_HIGH_VALUE_THRESHOLD=500000

# Referral program
REFERRAL_REWARD_POINTS=100
REFERRAL_ONBOARDING_COUPON=WELCOME10

# Backups (host paths — run ./deploy/backup.sh all before every deploy)
# Archives: backups/db/crumbs_db_YYYYMMDD_HHMMSS.sql.gz
#           backups/media/crumbs_media_YYYYMMDD_HHMMSS.tar.gz
# Never commit backup files. Copy off-server after each run. See docs/BACKUP_RESTORE.md

# --- Local development (uncomment for dev) ---
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# CSRF_TRUSTED_ORIGINS=http://localhost:8000
# POSTGRES_HOST=localhost
# REDIS_URL=
# SITE_URL=http://localhost:8000
# SMS_PROVIDER=console
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Local production Docker dry-run ---
# See LOCAL_PROD_DRY_RUN.md — copy .env.local-prod.example to .env
