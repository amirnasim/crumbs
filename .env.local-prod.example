# =============================================================================
# CRUMBS — Local production Docker dry-run (.env)
# Copy to .env before: docker compose -f docker-compose.production.yml up -d --build
# cp .env.local-prod.example .env
# =============================================================================

SECRET_KEY=local-prod-dry-run-change-me-to-50-plus-random-characters-min
DEBUG=False
LOCAL_PROD_DRY_RUN=True

DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080
SITE_URL=http://localhost:8080

ENABLE_HTTPS=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

CERTBOT_EMAIL=admin@localhost

POSTGRES_DB=crumbs
POSTGRES_USER=crumbs
POSTGRES_PASSWORD=local-prod-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

USE_WHITENOISE=False
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_PRELOAD=true

DEFAULT_PAYMENT_METHOD=cod
DEFAULT_PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://localhost:8080/payments/zarinpal/callback/
STRIPE_ENABLED=False

SMS_PROVIDER=console
SMS_ENABLED=True

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Container startup (default false — run migrate/collectstatic via deploy.sh)
RUN_MIGRATIONS_ON_STARTUP=false
RUN_COLLECTSTATIC_ON_STARTUP=false
